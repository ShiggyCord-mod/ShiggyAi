# ---- Discord ----
DISCORD_TOKEN=
CLIENT_ID=
# Optional: macht die Guild-Commands sofort auf diesem Server sichtbar statt global
# (global kann bis zu 1h dauern). /ask und /ping werden immer global registriert.
GUILD_ID=

# Komma-getrennte User-IDs, die /memory admin nutzen duerfen
TRUSTED_USER_IDS=

# ---- LLM (OpenAI-kompatible Chat-Completions-API) ----
# Default-Endpoint ist CodeCraft. Jeder andere OpenAI-kompatible Anbieter geht genauso,
# dann einfach LLM_BASE_URL umbiegen - im Code steht nichts anbieterspezifisches.
LLM_API_KEY=
LLM_BASE_URL=https://codecraftapi.com/v1

# Kein Default: gueltige Model-IDs haengen am Anbieter, ein geratener Name wuerde nur
# einen 400 beim ersten Request geben. Liste unter https://codecraftapi.com/models
# oder per `curl -H "Authorization: Bearer $LLM_API_KEY" https://codecraftapi.com/v1/models`.
LLM_MODEL=

# Nur fuer Reasoning-Modelle und nicht von jedem Endpoint akzeptiert, daher leer = weglassen.
# Sinnvolle Werte, falls unterstuetzt: low | medium | high
LLM_REASONING_EFFORT=

# ---- Bot-Verhalten ----
# Persona / System-Prompt. Enthaelt nie persoenliche Daten, die kommen aus dem Gedaechtnis.
BOT_PERSONA=Du bist ein hilfreicher Discord-Bot.

# Wieviele Nachrichten vor der aktuellen als Kurzzeit-Kontext geholt werden
SHORT_TERM_CONTEXT_LIMIT=15

# Clientseitiges Limit an Requests pro Minute, geteilt von Live-Antworten und passivem
# Lernen. Das echte Limit haengt am Tarif des Anbieters - hier bewusst konservativ.
RATE_LIMIT_RPM=10

# ---- Langzeitgedaechtnis ----
DB_PATH=./data/memory.sqlite

# Passives Lernen: extrahiert Memories auch aus Nachrichten, die NICHT an den Bot gerichtet
# sind - also von Leuten, die den Bot nie angesprochen haben. Laeuft gebatcht (nicht pro
# Nachricht), teilt sich aber das Budget aus RATE_LIMIT_RPM mit den Live-Antworten.
# LEARNING_ENABLED=false schaltet es ab.
LEARNING_ENABLED=true
LEARNING_BATCH_SIZE=20
LEARNING_SWEEP_INTERVAL_MINUTES=10
